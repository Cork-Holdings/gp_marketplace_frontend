			"item": [
				{
					"name": "Login System Admin",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Seeded super_admin. Required for Admin endpoints.",
						"auth": {
							"type": "noauth"
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@geepay.local\",\n  \"password\": \"AdminPass123!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status OK', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"  var b = pm.response.json();",
									"  if (b.access_token) {",
									"    pm.environment.set('accessToken', b.access_token);",
									"    pm.collectionVariables.set('accessToken', b.access_token);",
									"  }",
									"  var u = b.user || b;",
									"  if (u && u.id) { pm.environment.set('userId', u.id); }",
									"  if (b.merchant && b.merchant.id) { pm.environment.set('merchantId', b.merchant.id); }",
									"  var ms = (u && u.merchant_memberships) || b.merchant_memberships || b.memberships;",
									"  if (ms && ms[0] && ms[0].merchant_id) pm.environment.set('merchantId', ms[0].merchant_id);",
									"}"
								]
							}
						}
					]
				},
